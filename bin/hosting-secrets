#!/usr/bin/env bash
# Print freshly generated secrets for a hosted demo, as NAME=value lines.
#
#   bin/hosting-secrets > .env     # for docker compose (see docker-compose.yml)
#
# Or paste the values into your host's secret store. Keep them: the
# encryption keys are needed to read what the portal has stored.
set -euo pipefail

for name in DB_PASSWORD TAX_ENGINE_API_TOKEN SECRET_KEY_BASE AR_ENCRYPTION_PRIMARY_KEY AR_ENCRYPTION_DETERMINISTIC_KEY AR_ENCRYPTION_KEY_DERIVATION_SALT; do
  echo "$name=$(openssl rand -hex 32)"
done
