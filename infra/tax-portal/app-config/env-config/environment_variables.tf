locals {
  # Map from environment variable name to environment variable value
  # This is a map rather than a list so that variables can be easily
  # overridden per environment using terraform's `merge` function
  default_extra_environment_variables = {
    DB_AUTH_METHOD = "aws_iam"
    # Calculations come from the tax-engine service.
    TAX_ENGINE_ADAPTER = "http"
    # Example environment variables
    # WORKER_THREADS_COUNT    = 4
    # LOG_LEVEL               = "info"
    # DB_CONNECTION_POOL_SIZE = 5
  }

  # Configuration for secrets
  # List of configurations for defining environment variables that pull from SSM parameter
  # store. Configurations are of the format
  # {
  #   ENV_VAR_NAME = {
  #     manage_method     = "generated" # or "manual" for a secret that was created and stored in SSM manually
  #     secret_store_name = "/ssm/param/name"
  #   }
  # }
  secrets = {
    SECRET_KEY_BASE = {
      manage_method     = "generated"
      secret_store_name = "/${var.app_name}-${var.environment}/service/rails-secret-key-base"
    }

    # Token for the tax engine, generated by the tax-engine service layer.
    # Deploy tax-engine in this environment before tax-portal.
    TAX_ENGINE_API_TOKEN = {
      manage_method     = "manual"
      secret_store_name = "/tax-engine-${var.environment}/service/api-auth-token"
    }

    # Address of the tax engine in this environment, for example
    # "http://tax-engine-dev-123.us-east-1.elb.amazonaws.com". Create this
    # parameter by hand once tax-engine is deployed and its address is known.
    TAX_ENGINE_URL = {
      manage_method     = "manual"
      secret_store_name = "/${var.app_name}-${var.environment}/service/tax-engine-url"
    }

    # Example generated secret
    # RANDOM_SECRET = {
    #   manage_method     = "generated"
    #   secret_store_name = "/${var.app_name}-${var.environment}/random-secret"
    # }

    # Example secret that references a manually created secret
    # SECRET_SAUCE = {
    #   manage_method     = "manual"
    #   secret_store_name = "/${var.app_name}-${var.environment}/secret-sauce"
    # }
  }
}
