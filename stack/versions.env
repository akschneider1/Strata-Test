# Single source of truth for every pinned piece of the stack.
# Sourced by bin/setup-env, bin/new-app, bin/cods-upgrade and bin/doctor.
# Bump a value here, then re-run the relevant script (see README "Upgrading").

# --- Nava Strata ---------------------------------------------------------
# nava-platform CLI (https://github.com/navapbc/platform-cli), a commit SHA
NAVA_PLATFORM_CLI_REF=49dc298a30f3bf49e7ea588ba9216d4e59e9c56f
# Application templates (git tags on github.com/navapbc/template-application-*)
RAILS_TEMPLATE_VERSION=v1.0.0
NEXTJS_TEMPLATE_VERSION=v0.1.0
FLASK_TEMPLATE_VERSION=v0.4.1
# Strata SDK Rails engine (https://github.com/navapbc/strata-sdk-rails), a commit SHA
STRATA_SDK_REF=fab9c6b09a2266164eabd41a607b13058b19b25a
# Infra template version is recorded by nava-platform in .template-infra/base.yml

# --- Colorado Design System ----------------------------------------------
# GitHub release of github.com/coloradodigitalservice/colorado-design-system
CODS_VERSION=0.2.18
# Must match the @uswds/uswds version the CoDS release depends on
# (bin/cods-upgrade checks this for you).
USWDS_VERSION=3.14.0
# Dart Sass new enough for USWDS 3.14 syntax (CoDS itself builds with 1.105.2)
SASS_RANGE=^1.105.2

# --- Toolchain -----------------------------------------------------------
# Ruby required by the pinned Rails template (see <app>/.ruby-version)
RUBY_VERSION=3.4.9
PYTHON_VERSION=3.13
NODE_MIN_MAJOR=20
TERRAFORM_VERSION=1.10.5
ACTIONLINT_VERSION=1.7.7
