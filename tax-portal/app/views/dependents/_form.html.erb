<%# locals: (dependent:, url:, method:) %>
<% year = @tax_return.tax_year %>
<%= strata_form_with model: dependent, url: url, method: method do |f| %>
  <%= f.text_field :name_first, label: t("dependents.form.name_first"), autocomplete: "off" %>
  <%= f.text_field :name_last, label: t("dependents.form.name_last"), autocomplete: "off" %>
  <%= f.memorable_date :date_of_birth, legend: t("dependents.form.date_of_birth") %>
  <%= f.select :relationship, [ [ t("dependents.form.select"), "" ] ] + Dependent::RELATIONSHIPS.map { |r| [ t("dependents.relationships.#{r}"), r ] }, { label: t("dependents.form.relationship") } %>
  <%= f.text_field :ssn, label: t("dependents.form.ssn"), width: "md", inputmode: "numeric", autocomplete: "off", maxlength: 11 %>
  <%= f.yes_no :lived_with_filer_over_half_year, legend: t("dependents.form.lived_with", tax_year: year), hint: t("dependents.form.lived_with_hint") %>
  <%= f.fieldset t("dependents.form.details_legend") do %>
    <%= f.check_box :full_time_student, label: t("dependents.form.student") %>
    <%= f.check_box :disabled, label: t("dependents.form.disabled") %>
  <% end %>

  <hr class="border-base-lightest margin-top-4">
  <ul class="usa-button-group">
    <li class="usa-button-group__item"><%= link_to t("shared.cancel"), edit_dependents_tax_return_path(@tax_return), class: "usa-button usa-button--outline cods-button cods-button--secondary" %></li>
    <li class="usa-button-group__item"><%= f.button t("shared.save"), type: :submit, class: "usa-button cods-button" %></li>
  </ul>
<% end %>
