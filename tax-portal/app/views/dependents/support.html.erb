<% year = @tax_return.tax_year %>
<% title = t(".title", name: @dependent.name_first) %>
<% content_for :title, t(".page_title") %>
<%= content_for :content_col_class, "tablet:grid-col-10 desktop:grid-col-8" %>
<h1 class="font-heading-xl"><%= title %></h1>
<p class="usa-intro"><%= t(".lead") %></p>
<%= strata_form_with model: @dependent, url: update_support_tax_return_dependent_path(@tax_return, @dependent), method: :patch do |f| %>
  <%= f.yes_no :income_under_limit, legend: t(".income", amount: money(@income_limit), tax_year: year), hint: t(".income_hint") %>
  <%= f.yes_no :supported_by_filer, legend: t(".support", tax_year: year), hint: t(".support_hint") %>

  <hr class="border-base-lightest margin-top-4">
  <ul class="usa-button-group">
    <li class="usa-button-group__item"><%= link_to t("shared.back"), edit_tax_return_dependent_path(@tax_return, @dependent), class: "usa-button usa-button--outline cods-button cods-button--secondary" %></li>
    <li class="usa-button-group__item"><%= f.button t("shared.save"), type: :submit, class: "usa-button cods-button" %></li>
  </ul>
<% end %>
