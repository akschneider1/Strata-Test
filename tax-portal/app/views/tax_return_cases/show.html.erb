<% tr = @tax_return %>
<% under_review = @case.step == "review_return" %>
<% content_for :title, t(".title", confirmation: tr.confirmation_number) %>
<% fact = ->(label, value) { content_tag(:div, content_tag(:dt, label, class: "text-base-dark font-body-2xs") + content_tag(:dd, value, class: "margin-0 text-bold"), class: "margin-right-4 margin-bottom-1") } %>

<nav class="usa-breadcrumb cods-breadcrumbs padding-top-0" aria-label="Breadcrumbs">
  <ol class="usa-breadcrumb__list">
    <li class="usa-breadcrumb__list-item"><%= link_to t(".breadcrumb"), tax_return_cases_path, class: "usa-breadcrumb__link" %></li>
    <li class="usa-breadcrumb__list-item usa-current" aria-current="page"><span><%= tr.confirmation_number %></span></li>
  </ol>
</nav>

<div class="display-flex flex-align-center flex-wrap gap-2">
  <h1 class="font-heading-xl margin-y-1"><%= tr.filer_full_name %></h1>
  <span data-testid="case-step" data-step="<%= @case.step %>"><%= @case.outcome ? cods_tag(t("staff.outcomes.#{@case.outcome}"), "green") : case_step_tag(@case) %></span>
</div>

<dl class="display-flex flex-wrap margin-top-1 margin-bottom-3">
  <%= fact.call(t(".ssn"), masked(tr.filer_ssn)) %>
  <%= fact.call(t(".filing_status"), t("filing_statuses.#{@filed_calculation.filing_status}")) %>
  <%= fact.call(t(".submitted"), l(tr.submitted_at.in_time_zone("America/Denver"), format: :short)) %>
  <% if @task %>
    <%= fact.call(t(".assigned_to"), @task.assignee_id ? User.find(@task.assignee_id).display_name : t(".unassigned")) %>
    <%= fact.call(t(".due"), l(@task.due_on, format: :short)) %>
  <% end %>
  <%= fact.call(t(".result_filed"), result_phrase(@filed_calculation.refund, @filed_calculation.amount_owed)) %>
  <% if @case.adjusted_calculation %>
    <%= fact.call(t(".result_current"), content_tag(:span, result_phrase(@calculation.refund, @calculation.amount_owed), data: { testid: "current-result" })) %>
  <% end %>
</dl>

<div class="grid-row grid-gap-4">
  <div class="desktop:grid-col-8">
    <section aria-labelledby="flags-heading">
      <h2 id="flags-heading" class="font-heading-lg margin-top-0"><%= t(".flags_heading") %></h2>
      <% if @flags.any? %>
        <% @flags.each do |flag| %>
          <%= cods_alert(flag.resolved? ? :success : :warning, heading: t("staff.flags.#{flag.code}.title"), class: "margin-bottom-2", data: { flag: flag.code }) do %>
            <%= flag_description(flag) %>
            <% if flag.resolved? %><strong><%= t(".resolved") %>.</strong><% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-base-darker"><%= t(".no_flags") %></p>
      <% end %>
    </section>

    <section class="margin-top-4" aria-labelledby="income-heading">
      <h2 id="income-heading" class="font-heading-lg"><%= t(".income_heading") %></h2>
      <div class="usa-table-container--scrollable" tabindex="0">
        <table class="usa-table usa-table--compact width-full font-body-xs">
          <caption class="usa-sr-only"><%= t(".income_heading") %></caption>
          <thead>
            <tr>
              <% %w[form reported_amount on_file_amount reported_withholding on_file_withholding status].each do |column| %>
                <th scope="col"><%= t(".income_columns.#{column}") %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @income_documents.each do |document| %>
              <% record = document.wage_record %>
              <% disputed = document.review_status == "disputed" %>
              <% cell = ->(reported, on_file) do
                   differs = record && !disputed && reported != on_file
                   content_tag(:td, money(reported) + (differs ? content_tag(:span, " #{t('.differs')}", class: "usa-sr-only") : ""), class: class_names("text-right", "bg-warning-lighter text-bold": differs))
                 end %>
              <tr>
                <th scope="row"><%= income_kind_label(document.kind) %><% if tr.joint? %> · <%= document.owner == "filer" ? tr.filer_name_first : tr.spouse_name_first %><% end %><span class="display-block text-normal"><%= document.payer_name %></span></th>
                <% if disputed %>
                  <td class="text-right"><%= t(".left_off") %></td>
                <% else %>
                  <%= cell.call(document.amount, record&.amount) %>
                <% end %>
                <td class="text-right"><%= record ? money(record.amount) : t(".no_record") %></td>
                <% if disputed %>
                  <td class="text-right">—</td>
                <% else %>
                  <%= cell.call(document.colorado_withholding, record&.colorado_withholding) %>
                <% end %>
                <td class="text-right"><%= record ? money(record.colorado_withholding) : t(".no_record") %></td>
                <td><%= t("tax_returns.edit_income_documents.status.#{document.review_status}") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="margin-top-4" aria-labelledby="household-heading">
      <h2 id="household-heading" class="font-heading-lg"><%= t(".household_heading") %></h2>
      <dl class="display-flex flex-wrap">
        <% if tr.joint? %><%= fact.call(t(".spouse"), "#{tr.spouse_full_name} · #{masked(tr.spouse_ssn)}") %><% end %>
        <%= fact.call(t(".dependents"), tr.dependents.any? ? tr.dependents.map { |d| "#{d.full_name} (#{d.age_at_year_end}, #{t("dependents.relationships.#{d.relationship}").downcase})" }.join("; ") : t(".none")) %>
      </dl>
    </section>

    <% if @case.return_adjustments.any? %>
      <section class="margin-top-4" aria-labelledby="adjustments-heading">
        <h2 id="adjustments-heading" class="font-heading-lg"><%= t(".adjustments_heading") %></h2>
        <ul class="usa-list">
          <% @case.return_adjustments.order(:created_at).includes(:adjusted_by).each do |adjustment| %>
            <li>
              <strong><%= t("adjustable_fields.#{adjustment.field}") %>: <%= money(adjustment.filed_amount) %> → <%= money(adjustment.adjusted_amount) %></strong><br>
              <%= t(".adjustment_by", name: adjustment.adjusted_by.display_name, reason: adjustment.reason) %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @case.information_requests.any? %>
      <section class="margin-top-4" aria-labelledby="questions-heading">
        <h2 id="questions-heading" class="font-heading-lg"><%= t(".questions_heading") %></h2>
        <% @case.information_requests.order(:created_at).each do |request| %>
          <div class="border-left-05 border-base-light padding-left-2 margin-bottom-2">
            <p class="margin-y-05"><strong><%= t(".asked") %>:</strong> <%= request.question %></p>
            <% if request.answered? %>
              <p class="margin-y-05" data-testid="taxpayer-answer"><strong><%= t(".answered") %>:</strong> <%= request.response %></p>
            <% else %>
              <p class="margin-y-05 text-base-darker"><%= t(".awaiting_answer") %></p>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section class="margin-top-4" aria-labelledby="calculation-heading">
      <h2 id="calculation-heading" class="font-heading-lg margin-bottom-0"><%= t(".calculation_heading") %></h2>
      <p class="text-base-darker margin-top-05"><%= t(".calculation_lead") %></p>
      <details>
        <summary class="usa-link"><%= t("tax_returns.summary.title") %></summary>
        <%= render "tax_returns/calculation", calculation: @calculation, tax_year: tr.tax_year %>
      </details>
    </section>

    <section class="margin-top-4" id="notes" aria-labelledby="notes-heading">
      <h2 id="notes-heading" class="font-heading-lg"><%= t(".notes_heading") %></h2>
      <% notes = @case.case_notes.order(:created_at).includes(:author) %>
      <% if notes.any? %>
        <% notes.each do |note| %>
          <div class="border-left-05 border-base-light padding-left-2 margin-bottom-2">
            <%= simple_format(note.body, class: "margin-y-05") %>
            <p class="margin-y-05 font-body-2xs text-base-dark"><%= note.author.display_name %> · <%= l(note.created_at.in_time_zone("America/Denver"), format: :short) %></p>
          </div>
        <% end %>
      <% else %>
        <p class="text-base-darker"><%= t(".no_notes") %></p>
      <% end %>
      <%= strata_form_with model: @note, url: add_note_tax_return_case_path(@case), method: :post do |f| %>
        <%= f.text_area :body, label: t(".note_label"), hint: t(".note_hint"), rows: 3 %>
        <%= f.button t(".note_submit"), type: :submit, class: "usa-button usa-button--outline cods-button cods-button--secondary margin-top-2" %>
      <% end %>
    </section>

    <section class="margin-top-4" aria-labelledby="history-heading">
      <h2 id="history-heading" class="font-heading-lg"><%= t(".history_heading") %></h2>
      <ol class="usa-list usa-list--unstyled" data-testid="history">
        <% @history.each do |line| %>
          <li class="border-top-1px border-base-lighter padding-y-1 maxw-none">
            <%= audit_line_summary(line) %>
            <span class="text-base-dark font-body-2xs display-block"><%= actor_name(line) %> · <%= l(line.created_at.in_time_zone("America/Denver"), format: :short) %></span>
          </li>
        <% end %>
      </ol>
    </section>
  </div>

  <aside class="desktop:grid-col-4" aria-labelledby="actions-heading">
    <div class="border-1px border-base-light radius-md padding-3 position-sticky top-2">
      <h2 id="actions-heading" class="font-heading-lg margin-top-0"><%= t(".actions_heading") %></h2>
      <% if under_review %>
        <% if @task && @task.assignee_id != current_user.id %>
          <%= button_to t(".assign_to_me"), assign_to_me_tax_return_case_path(@case), method: :patch, class: "usa-button usa-button--outline cods-button cods-button--secondary margin-bottom-3" %>
        <% end %>

        <h3 class="font-heading-md margin-top-0"><%= t(".approve_heading") %></h3>
        <p class="margin-top-0 text-base-darker">
          <%= t(@case.return_adjustments.any? ? ".approve_hint_adjusted" : ".approve_hint_filed", result: result_phrase(@calculation.refund, @calculation.amount_owed)) %>
        </p>
        <%= button_to t(@case.return_adjustments.any? ? ".approve_adjusted" : ".approve_as_filed"), approve_tax_return_case_path(@case), method: :patch, class: "usa-button cods-button" %>

        <hr class="margin-y-3 border-base-lighter">
        <h3 class="font-heading-md"><%= t(".adjust_heading") %></h3>
        <%= strata_form_with model: @adjustment, url: adjust_tax_return_case_path(@case), method: :post do |f| %>
          <% facts = @case.adjusted_facts %>
          <%= f.select :field, [ [ t(".select"), "" ] ] + TaxEngine::Facts::ADJUSTABLE.keys.map { |field| [ "#{t("adjustable_fields.#{field}")} (#{t('.current_amount', amount: money(facts.value(field)))})", field ] }, { label: t(".adjust_field") } %>
          <%= f.text_field :adjusted_amount, label: t(".adjust_amount"), prefix: "$", inputmode: "numeric" %>
          <%= f.text_area :reason, label: t(".adjust_reason"), hint: t(".adjust_reason_hint"), rows: 3 %>
          <%= f.button t(".adjust_submit"), type: :submit, class: "usa-button usa-button--outline cods-button cods-button--secondary margin-top-2" %>
        <% end %>

        <hr class="margin-y-3 border-base-lighter">
        <h3 class="font-heading-md"><%= t(".request_heading") %></h3>
        <%= strata_form_with model: @information_request, url: request_information_tax_return_case_path(@case), method: :post do |f| %>
          <%= f.text_area :question, label: t(".request_question"), hint: t(".request_hint"), rows: 4 %>
          <%= f.button t(".request_submit"), type: :submit, class: "usa-button usa-button--outline cods-button cods-button--secondary margin-top-2" %>
        <% end %>
      <% elsif @case.step == "provide_information" %>
        <p><%= t(".waiting_on_taxpayer") %></p>
      <% else %>
        <p><%= t(".closed") %> <strong><%= t("staff.outcomes.#{@case.outcome}") if @case.outcome %></strong></p>
      <% end %>
    </div>
  </aside>
</div>
