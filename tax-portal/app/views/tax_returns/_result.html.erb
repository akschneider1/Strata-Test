<%# locals: (calculation:, breakdown: false) %>
<%# Headline result of a calculation. With `breakdown`, the three engine totals behind it sit underneath. %>
<div class="border-left-05 border-primary bg-primary-lighter padding-x-3 padding-y-2 margin-y-2">
  <% if calculation.refund? %>
    <p class="margin-0 font-body-sm"><%= t("tax_calculation.lines.refund.label") %></p>
    <p class="margin-0 font-heading-2xl text-bold" data-testid="refund"><%= money(calculation.refund) %></p>
  <% elsif calculation.owes? %>
    <p class="margin-0 font-body-sm"><%= t("tax_calculation.lines.amount_owed.label") %></p>
    <p class="margin-0 font-heading-2xl text-bold" data-testid="amount-owed"><%= money(calculation.amount_owed) %></p>
  <% else %>
    <p class="margin-0 text-bold"><%= t("tax_returns.summary.even_heading") %></p>
  <% end %>
  <% if breakdown %>
    <div class="margin-top-2 padding-top-1 border-top-1px border-primary-light">
      <dl class="grid-row grid-gap margin-0" data-testid="glance">
        <% { tax: :net_tax, credits: :refundable_credits, withheld: :colorado_tax_withheld }.each do |key, line_id| %>
          <div class="grid-col-12 mobile-lg:grid-col-4 padding-top-1">
            <dt class="font-body-xs"><%= t("tax_returns.summary.glance.#{key}") %></dt>
            <dd class="margin-0 font-body-lg text-bold"><%= money(calculation.amount(line_id)) %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>
</div>
