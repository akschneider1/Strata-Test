<% year = @tax_return.tax_year %>
<% stage = @case.stage %>
<% content_for :title, t(".title", tax_year: year) %>
<%# Processing usually finishes within seconds of filing: check again shortly. %>
<%# Turbo ignores a refresh tag swapped into the page, so also ask it to load this page in full. %>
<% if stage == :received %>
  <% content_for :head do %>
    <%= tag.meta name: "turbo-visit-control", content: "reload" %>
    <%= tag.meta "http-equiv": "refresh", content: "3" %>
  <% end %>
<% end %>
<% timeline_keys = {
  "return.calculated" => "calculated",
  "review.information_requested" => "information_requested",
  "taxpayer.information_provided" => "information_provided",
  "review.adjusted" => "adjusted",
  "return.accepted" => "accepted",
  "return.accepted_with_adjustments" => "accepted",
  "return.not_accepted" => "not_accepted"
} %>

<% hero t(".title", tax_year: year) %>

<%# The timeline sits beside the details on a wide screen, and under them on a phone. %>
<div class="grid-row grid-gap-4">
<div class="grid-col-12 desktop:grid-col-8">
<% alert_type = { accepted: :success, needs_information: :warning, not_accepted: :error }.fetch(stage, :info) %>
<%# An accepted return with tax due is not a "success" for the taxpayer: there is still something to do. %>
<% alert_type = :info if stage == :accepted && @calculation.owes? %>
<%# Until the return is accepted the amount can still change, so say it is an estimate. %>
<% amount_key = @calculation.owes? ? "owed" : "refund" %>
<%= cods_alert alert_type, heading: t("tax_returns.stages.#{stage}.heading"), data: { testid: "stage", stage: stage } do %>
  <% if stage == :accepted %>
    <% if @calculation.refund? && @tax_return.direct_deposit? %>
      <%= t("tax_returns.stages.accepted.body_refund_direct_deposit", amount: money(@calculation.refund), account: @tax_return.bank_account_number.to_s.last(4)) %>
    <% elsif @calculation.refund? %>
      <%= t("tax_returns.stages.accepted.body_refund_check", amount: money(@calculation.refund)) %>
    <% elsif @calculation.owes? %>
      <%= t("tax_returns.stages.accepted.body_owed", amount: money(@calculation.amount_owed), due_year: year + 1) %>
    <% else %>
      <%= t("tax_returns.stages.accepted.body_even") %>
    <% end %>
  <% else %>
    <%= t("tax_returns.stages.#{stage}.body") %>
  <% end %>
<% end %>

<% if stage == :not_accepted && @case.not_accepted_reason %>
  <section class="margin-top-4" aria-labelledby="not-accepted-heading">
    <h2 id="not-accepted-heading" class="font-heading-lg"><%= t("tax_returns.stages.not_accepted.reason_heading") %></h2>
    <p data-testid="not-accepted-reason"><%= @case.not_accepted_reason %></p>
  </section>
<% end %>

<% if @information_request %>
  <section class="margin-top-4 border-2px border-primary radius-md padding-3" aria-labelledby="question-heading">
    <h2 id="question-heading" class="font-heading-lg margin-top-0"><%= t(".question_heading") %></h2>
    <blockquote class="margin-x-0 padding-left-2 border-left-05 border-base-light"><%= simple_format(@information_request.question, class: "margin-y-1") %></blockquote>
    <%= strata_form_with model: @information_request, url: respond_tax_return_path(@tax_return), method: :patch do |f| %>
      <%= f.text_area :response, label: t(".response_label"), hint: t(".response_hint"), rows: 5 %>
      <%= f.button t(".send"), type: :submit, class: "usa-button cods-button margin-top-2" %>
    <% end %>
  </section>
<% end %>

<section class="margin-top-4" aria-labelledby="details-heading">
  <h2 id="details-heading" class="font-heading-lg"><%= t(".details_heading") %></h2>
  <dl class="margin-0 border-top-1px border-base-lighter">
    <div class="display-flex flex-justify flex-align-center gap-2 border-bottom-1px border-base-lighter padding-y-1">
      <dt><%= t(".stage_label") %></dt>
      <dd class="margin-0 text-right"><%= stage_tag(stage) %></dd>
    </div>
    <div class="display-flex flex-justify gap-2 border-bottom-1px border-base-lighter padding-y-1">
      <dt><%= t(".confirmation") %></dt>
      <dd class="margin-0 text-bold text-right" data-testid="confirmation-number"><%= @tax_return.confirmation_number %></dd>
    </div>
    <div class="display-flex flex-justify gap-2 border-bottom-1px border-base-lighter padding-y-1">
      <dt><%= t(".submitted_on") %></dt>
      <dd class="margin-0 text-bold text-right"><%= plain_time(@tax_return.submitted_at) %></dd>
    </div>
    <% unless stage == :not_accepted %>
    <div class="display-flex flex-justify gap-2 border-bottom-1px border-base-lighter padding-y-1">
      <dt><%= stage == :accepted ? t("tax_calculation.lines.#{@calculation.owes? ? 'amount_owed' : 'refund'}.label") : t(".estimated_#{amount_key}") %></dt>
      <dd class="margin-0 text-bold text-right" data-testid="result-amount"><%= money(@calculation.owes? ? @calculation.amount_owed : @calculation.refund) %></dd>
    </div>
    <% end %>
  </dl>
  <p class="margin-top-2"><%= link_to t(".see_calculation"), summary_tax_return_path(@tax_return), class: "usa-button usa-button--outline cods-button cods-button--secondary" %></p>
</section>

<% if @case.return_adjustments.any? %>
  <section class="margin-top-4" aria-labelledby="adjustments-heading">
    <h2 id="adjustments-heading" class="font-heading-lg"><%= t(".adjustments_heading") %></h2>
    <ul class="usa-list">
      <% @case.return_adjustments.order(:created_at).each do |adjustment| %>
        <li>
          <%= t(".adjustment", field: t("adjustable_fields.#{adjustment.field}"), from: money(adjustment.filed_amount), to: money(adjustment.adjusted_amount)) %><br>
          <span class="text-base-darker"><%= t(".adjustment_reason", reason: adjustment.reason) %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% answered = @case.information_requests.where.not(responded_at: nil).order(:created_at) %>
<% if answered.any? %>
  <section class="margin-top-4" aria-labelledby="past-questions-heading">
    <h2 id="past-questions-heading" class="font-heading-lg"><%= t(".past_questions_heading") %></h2>
    <% answered.each do |request| %>
      <div class="border-left-05 border-base-light padding-left-2 margin-bottom-2">
        <p class="margin-y-05"><strong><%= t(".question_heading") %>:</strong> <%= request.question %></p>
        <p class="margin-y-05"><strong><%= t(".response_label") %>:</strong> <%= request.response %></p>
      </div>
    <% end %>
  </section>
<% end %>

</div>

<section class="grid-col-12 desktop:grid-col-4 margin-top-4 desktop:margin-top-0" aria-labelledby="timeline-heading">
  <h2 id="timeline-heading" class="font-heading-lg desktop:margin-top-0"><%= t(".timeline_heading") %></h2>
  <ol class="usa-list usa-list--unstyled border-top-1px border-base-lighter" data-testid="timeline">
    <li class="display-flex flex-column border-bottom-1px border-base-lighter padding-y-1 margin-0 maxw-none">
      <span><%= t(".timeline.submitted") %></span>
      <span class="text-base-dark font-body-xs"><%= short_time(@tax_return.submitted_at) %></span>
    </li>
    <% @case.audit_lines.order(:created_at).each do |line| %>
      <% key = line.action == "return.screened" ? (line.data["flags"].present? ? "screened_flagged" : "screened_clear") : timeline_keys[line.action] %>
      <% next unless key %>
      <li class="display-flex flex-column border-bottom-1px border-base-lighter padding-y-1 margin-0 maxw-none">
        <span><%= t(".timeline.#{key}") %></span>
        <span class="text-base-dark font-body-xs"><%= short_time(line.created_at) %></span>
      </li>
    <% end %>
  </ol>
</section>
</div>
