############################
# Rails
############################

RAILS_ENV=development

############################
# Rails: Urls
############################

APP_HOST=localhost
APP_PORT=3100

############################
# AWS services
############################

AWS_ACCESS_KEY_ID=<FILL ME IN>
AWS_SECRET_ACCESS_KEY=<FILL ME IN>
AWS_DEFAULT_REGION=<FILL ME IN>

############################
# File storage
############################

# Uncomment and fill in an AWS S3 bucket name to use S3 for file storage
# BUCKET_NAME=<FILL ME IN>

############################
# Auth
############################

COGNITO_USER_POOL_ID=<FILL ME IN>
COGNITO_CLIENT_ID=<FILL ME IN>
COGNITO_CLIENT_SECRET=<FILL ME IN>

# "mock" to enable local login with any email/password combo; "cognito" to use the proper authentication flow
AUTH_ADAPTER="mock"

############################
# Database
############################

DB_HOST=127.0.0.1
DB_NAME=app
DB_USER=app
DB_PASSWORD=secret123

############################
# Lookbook
############################

ENABLE_LOOKBOOK=true

############################
# Tax prototype
############################

# Where the tax engine (the tax-engine app, PolicyEngine) is running
TAX_ENGINE_URL=http://127.0.0.1:3200
TAX_ENGINE_API_TOKEN=LOCAL_AUTH_12345678
# "http" to call the tax engine; "fake" for simplified offline math (tests)
TAX_ENGINE_ADAPTER=http

# Show one-click sign-in for seeded demo people on the home page.
# Ignored in production.
DEMO_MODE=true
